# Clone a repo using a bare worktree structure
# Usage: gwclone <repo-url> [directory-name]
gwclone() {
  if [ -z "$1" ]; then
    echo "Usage: gwclone <repo-url> [directory-name]"
    return 1
  fi

  local repo_url="$1"
  local folder_name="$2"

  # Infer folder name from repo URL if not explicitly provided
  if [ -z "$folder_name" ]; then
    folder_name=$(basename "$repo_url" .git)
  fi

  echo "Setting up bare worktree structure in ./${folder_name}..."
  
  mkdir -p "$folder_name" && cd "$folder_name" || return 1

  # 1. Clone bare database
  git clone --bare "$repo_url" .bare || return 1

  # 2. Redirect root .git file
  echo "gitdir: ./.bare" > .git

  # 3. Fix remote fetch refspec
  git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  git fetch origin

  # 4. Query remote origin for the actual default branch name (main, master, develop, etc.)
  local default_branch
  default_branch=$(git remote show origin | awk '/HEAD branch/ {print $NF}')

  # Fallback checks if remote query fails or returns empty
  if [ -z "$default_branch" ] || [ "$default_branch" = "(unknown)" ]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      default_branch="main"
    elif git rev-parse --verify origin/master >/dev/null 2>&1; then
      default_branch="master"
    else
      echo "Error: Could not automatically detect remote default branch."
      return 1
    fi
  fi

  # 5. Set up remote HEAD reference
  git remote set-head origin "$default_branch" 2>/dev/null

  # 6. Add default worktree
  git worktree add "$default_branch" "$default_branch"

  # 7. Set up upstream tracking for fetch/pull/push
  git -C "$default_branch" branch --set-upstream-to="origin/${default_branch}" "$default_branch"

  # Navigate into default branch directory
  cd "$default_branch" || return 1
  echo "Done! Created worktree structure, tracked 'origin/${default_branch}', and checked out at: $(pwd)"
}

# Create a new feature worktree and switch to it immediately
# Usage: gwadd <branch-or-folder-name> [base-branch]
gwadd() {
  if [ -z "$1" ]; then
    echo "Usage: gwadd <branch-or-folder-name> [base-branch]"
    return 1
  fi

  local name="$1"
  local base_branch="${2:-HEAD}"
  
  # Normalize branch name (e.g., feature/login -> feature-login for folder name)
  local folder_name
  folder_name=$(echo "$name" | tr '/' '-')

  # Determine path (assumes execution inside a sibling worktree directory)
  local target_dir="../${folder_name}"

  echo "Creating worktree at ${target_dir}..."

  # Create branch and worktree if it doesn't exist, or checkout existing branch
  if git rev-parse --verify "$name" >/dev/null 2>&1; then
    git worktree add "$target_dir" "$name" || return 1
  else
    git worktree add -b "$name" "$target_dir" "$base_branch" || return 1
  fi

  # Change into the new directory
  cd "$target_dir" || return 1
  echo "Switched to new worktree: $(pwd)"
}

# Remove a worktree and its corresponding local branch
# Usage: gwrm [worktree-folder-or-branch-name]
gwrm() {
  local target="$1"

  # If no target specified, offer to delete the CURRENT worktree directory
  if [ -z "$target" ]; then
    local current_dir
    current_dir=$(basename "$PWD")
    
    echo -n "No target specified. Remove CURRENT worktree '$current_dir'? [y/N]: "
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
      echo "Aborted."
      return 0
    fi
    target="$current_dir"
  fi

  # Resolve folder name and branch name
  local folder_name
  folder_name=$(echo "$target" | tr '/' '-')
  
  # Determine path relative to execution
  local target_path="../${folder_name}"
  if [ -d "$target" ]; then
    target_path="$target"
  fi

  # Prevent accidental deletion of main workspace branches
  if [[ "$folder_name" == "main" || "$folder_name" == "master" ]]; then
    echo "Error: Refusing to delete the primary branch ('$folder_name')."
    return 1
  fi

  # Get the branch name tied to this worktree before removing it
  local branch_name
  branch_name=$(git -C "$target_path" branch --show-current 2>/dev/null)

  # If operating inside the directory being removed, step out first
  if [[ "$PWD" -ef "$target_path" ]]; then
    cd .. || return 1
  fi

  echo "Removing worktree at '${target_path}'..."
  git worktree remove --force "$target_path" || return 1

  # Delete the corresponding branch if it exists
  if [ -n "$branch_name" ] && git rev-parse --verify "$branch_name" >/dev/null 2>&1; then
    echo "Deleting branch '${branch_name}'..."
    git branch -D "$branch_name"
  fi

  # Prune obsolete worktree administrative data
  git worktree prune

  echo "Successfully removed worktree and branch."
}
